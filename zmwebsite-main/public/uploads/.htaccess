# ==============================================================================
# ZM PRINTING CMS - UPLOADS DIRECTORY SECURITY
# Prevent any script execution inside uploads directory
# ==============================================================================

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|exe|sh|py)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Only allow legitimate media files to be read
<FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|pdf)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

Options -Indexes -ExecCGI

